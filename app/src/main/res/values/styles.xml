<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NpTitle">
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/np_text_primary</item>
    </style>
    <style name="NpSubtitle">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/np_text_secondary</item>
    </style>
    <style name="NpBody">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/np_text_primary</item>
    </style>
    <style name="NpCaption">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/np_text_secondary</item>
    </style>
    <style name="NpSection">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/np_text_primary</item>
    </style>
    <style name="NpIconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
        <item name="tint">@color/np_text_primary</item>
    </style>
    <style name="NpCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/np_card_radius</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">@color/np_surface</item>
    </style>
    <style name="NpButtonPrimary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/np_primary</item>
        <item name="android:textColor">@color/np_on_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="NpButtonLight" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/np_primary_light</item>
        <item name="android:textColor">@color/np_primary</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="NpButtonDanger" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="backgroundTint">@color/np_danger_light</item>
        <item name="android:textColor">@color/np_danger</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="elevation">0dp</item>
    </style>
    <style name="NpFab" parent="Widget.MaterialComponents.FloatingActionButton">
        <item name="backgroundTint">@color/np_primary</item>
        <item name="tint">@color/np_on_primary</item>
    </style>
    <style name="NpChip" parent="Widget.MaterialComponents.Chip.Choice">
        <item name="chipBackgroundColor">@color/np_chip_bg</item>
        <item name="android:textColor">@color/np_chip_text</item>
        <item name="chipStrokeWidth">0dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="NpInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/np_text_primary</item>
        <item name="android:textColorHint">@color/np_text_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="NpSettingTitle">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/np_text_primary</item>
    </style>
</resources>
