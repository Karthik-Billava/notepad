<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">

    <ImageButton
        android:id="@+id/header_nav"
        style="@style/NpIconButton"
        android:contentDescription="@string/cd_menu"
        android:src="@drawable/ic_menu" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/header_title"
            style="@style/NpTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/header_subtitle"
            style="@style/NpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/header_action"
        style="@style/NpIconButton"
        android:contentDescription="@string/edit"
        android:src="@drawable/ic_edit"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/header_search"
        style="@style/NpIconButton"
        android:contentDescription="@string/search"
        android:src="@drawable/ic_search" />

    <ImageButton
        android:id="@+id/header_more"
        style="@style/NpIconButton"
        android:contentDescription="@string/more_options"
        android:src="@drawable/ic_more_vert" />
</LinearLayout>
