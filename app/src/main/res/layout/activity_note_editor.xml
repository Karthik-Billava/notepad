<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <include
        android:id="@+id/header"
        layout="@layout/include_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/NpSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/label_title" />

            <EditText
                android:id="@+id/et_title"
                style="@style/NpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:hint="@string/title_hint"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1" />

            <TextView
                android:id="@+id/tv_title_counter"
                style="@style/NpCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end" />

            <TextView
                style="@style/NpSection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/label_note" />

            <EditText
                android:id="@+id/et_content"
                style="@style/NpInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="top|start"
                android:hint="@string/content_hint"
                android:inputType="textMultiLine|textCapSentences"
                android:minHeight="200dp" />

            <TextView
                android:id="@+id/tv_counts"
                style="@style/NpCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_info_box"
                android:orientation="horizontal"
                android:padding="4dp">

                <ImageButton
                    android:id="@+id/btn_bold"
                    style="@style/NpIconButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/format_bold"
                    android:src="@drawable/ic_bold" />

                <ImageButton
                    android:id="@+id/btn_italic"
                    style="@style/NpIconButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/format_italic"
                    android:src="@drawable/ic_italic" />

                <ImageButton
                    android:id="@+id/btn_underline"
                    style="@style/NpIconButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/format_underline"
                    android:src="@drawable/ic_underline" />

                <ImageButton
                    android:id="@+id/btn_bullet"
                    style="@style/NpIconButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/format_list"
                    android:src="@drawable/ic_list_bullet" />

                <ImageButton
                    android:id="@+id/btn_link"
                    style="@style/NpIconButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:contentDescription="@string/format_link"
                    android:src="@drawable/ic_link" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_card"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_star_border"
                        app:tint="@color/np_primary" />

                    <TextView
                        style="@style/NpBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/add_to_favourites" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sw_favorite"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/add_to_favourites" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_todo"
                        app:tint="@color/np_primary" />

                    <TextView
                        style="@style/NpBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/mark_as_todo" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/sw_todo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@string/mark_as_todo" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/row_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_alarm"
                        app:tint="@color/np_primary" />

                    <TextView
                        style="@style/NpBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/set_alarm" />

                    <TextView
                        android:id="@+id/tv_alarm_value"
                        style="@style/NpCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/np_text_secondary" />
                </LinearLayout>
                <LinearLayout
                    android:id="@+id/row_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:minHeight="56dp"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="8dp">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_label"
                        app:tint="@color/np_primary" />

                    <TextView
                        style="@style/NpBody"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:text="@string/add_tag" />

                    <TextView
                        android:id="@+id/tv_tags_value"
                        style="@style/NpCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="4dp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/np_text_secondary" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <Button
            android:id="@+id/btn_cancel"
            style="@style/NpButtonLight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:text="@string/cancel" />

        <Button
            android:id="@+id/btn_save"
            style="@style/NpButtonPrimary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1.4"
            android:text="@string/save_note" />
    </LinearLayout>
</LinearLayout>
