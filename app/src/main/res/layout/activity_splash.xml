<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground">

    <View
        android:layout_width="260dp"
        android:layout_height="260dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-90dp"
        android:layout_marginTop="-90dp"
        android:background="@drawable/bg_splash_blob" />

    <View
        android:layout_width="320dp"
        android:layout_height="320dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-120dp"
        android:layout_marginBottom="-140dp"
        android:background="@drawable/bg_splash_blob" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="104dp"
            android:layout_height="104dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_app_logo" />

        <TextView
            android:id="@+id/tv_splash_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textColor="@color/np_text_primary"
            android:textSize="40sp"
            android:textStyle="bold" />

        <TextView
            style="@style/NpSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/tagline"
            android:textSize="16sp" />

        <ProgressBar
            android:id="@+id/splash_progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="160dp"
            android:layout_height="6dp"
            android:layout_marginTop="48dp"
            android:max="100"
            android:progressDrawable="@drawable/bg_progress" />

        <TextView
            style="@style/NpCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/loading" />
    </LinearLayout>
</FrameLayout>
